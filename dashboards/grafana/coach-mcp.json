{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud metrics)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo (Grafana Cloud traces)",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "title": "coach-mcp-for-garmin",
  "description": "Tool calls, Garmin calls, history indexing and eval cost (docs/tracing.md). No values, names or ids: only the allowlisted labels of ext/telemetry.py.",
  "tags": [
    "coach-mcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Tool calls",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Calls per tool",
      "description": "Tool calls in each interval, by tool.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_tool) (increase(coach_tool_calls_total[$__rate_interval]))",
          "legendFormat": "{{coach_tool}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Error rate by group",
      "description": "Share of tool calls that failed in the last hour, by fixed error group.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_error_group) (increase(coach_tool_calls_total{coach_outcome=\"error\"}[1h])) / ignoring(coach_error_group) group_left sum(increase(coach_tool_calls_total[1h]))",
          "legendFormat": "{{coach_error_group}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "p50 / p95 latency per tool",
      "description": "Answers 'sleep calls slow today'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, coach_tool) (rate(coach_tool_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{coach_tool}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, coach_tool) (rate(coach_tool_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{coach_tool}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Answer size p95 per tool",
      "description": "Answer size is a proxy for the context cost an answer adds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, coach_tool) (rate(coach_tool_answer_size_bytes_bucket[$__rate_interval])))",
          "legendFormat": "{{coach_tool}}"
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "Garmin",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Garmin calls by caller and outcome",
      "description": "caller = tool (a live call) or worker (the history indexer).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_caller, coach_outcome) (increase(coach_garmin_requests_total[$__rate_interval]))",
          "legendFormat": "{{coach_caller}} {{coach_outcome}}"
        }
      ],
      "id": 7
    },
    {
      "type": "stat",
      "title": "Rate limits and logins (7 days)",
      "description": "Answers '3 rate-limit errors this week' and who caused them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_caller, coach_error_group) (increase(coach_garmin_requests_total{coach_error_group=~\"rate_limited|login\"}[7d]))",
          "legendFormat": "{{coach_caller}} {{coach_error_group}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Garmin p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, coach_caller) (rate(coach_garmin_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{coach_caller}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Cooldown active",
      "description": "1 while the shared Garmin cooldown pauses calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "max by (coach_error_group) (coach_garmin_cooldown_active)",
          "legendFormat": "{{coach_error_group}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Status sources missing",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_source_name) (increase(coach_status_sources_total{coach_outcome=~\"missing|timeout\"}[$__rate_interval]))",
          "legendFormat": "{{coach_source_name}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Key-mode token source",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_garmin_token_source) (increase(coach_garmin_token_total[$__rate_interval]))",
          "legendFormat": "{{coach_garmin_token_source}}"
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "History and jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": [],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "History lag (days)",
      "description": "Days between yesterday and the newest indexed day. Alert above 3.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "max(coach_history_lag_days)",
          "legendFormat": "lag"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Queue depth by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "max by (coach_job_status) (coach_queue_depth)",
          "legendFormat": "{{coach_job_status}}"
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Jobs done and failed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (coach_job_kind, coach_job_status) (increase(coach_jobs_total{coach_job_status=~\"done|failed\"}[$__rate_interval]))",
          "legendFormat": "{{coach_job_kind}} {{coach_job_status}}"
        }
      ],
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Queue wait p95 and oldest queued job",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coach_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "wait p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "max(coach_queue_oldest_age_seconds)",
          "legendFormat": "oldest queued"
        }
      ],
      "id": 17
    },
    {
      "type": "row",
      "title": "Evals (live runs)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "panels": [],
      "id": 18
    },
    {
      "type": "stat",
      "title": "Eval cost per model (USD, 30 days)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (increase(coach_eval_cost_total[30d]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "id": 19
    },
    {
      "type": "timeseries",
      "title": "Tokens per model call p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_token_type) (rate(gen_ai_client_token_usage_bucket[$__rate_interval])))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "id": 20
    },
    {
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"coach-mcp-for-garmin\" && name =~ \"tool .*\" }",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 21
    }
  ]
}
