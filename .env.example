# Service variables (PLACEHOLDERS ONLY). scripts/deploy.sh sets the real ones.
# Garmin email/password are never stored anywhere: you log in once, interactively,
# inside the container with `railway ssh` + `garmin-mcp-auth --token-path /data/tokens`.

# Required by the Caddy proxy on every path except /healthz and /readyz.
# Generated at deploy time with: openssl rand -hex 32
MCP_BEARER_TOKEN=generated-at-deploy

# Garmin OAuth tokens live on the volume mounted at /data.
GARMINTOKENS=/data/tokens
GARMIN_MCP_STATELESS_HTTP=true

# Required: your IANA time zone. get_daily_status and get_weekly_status use it
# for "today" and "yesterday". The container refuses to start without a valid
# value. Example only; use your own zone.
REPORT_TZ=Europe/London

# Tools: the server exposes only the read-only tools listed in
# config/enabled-tools.txt, which is baked into the image. Write tools cannot be
# enabled. Optional: GARMIN_ENABLED_TOOLS (comma-separated) narrows that list;
# a name that is not in it (a write tool, an unknown name) stops the server at
# startup.
# GARMIN_ENABLED_TOOLS=get_activities,get_daily_status,get_sleep_summary

# Railway injects PORT; 8080 is the local default. Transport, host and the internal
# port (127.0.0.1:8000) are fixed by entrypoint.sh and cannot be overridden.
PORT=8080
